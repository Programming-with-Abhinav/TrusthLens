# Optional: used only for claim searches.
GOOGLE_FACTCHECK_API_KEY=your_fact_check_api_key_here

# Optional and separate: Web Risk lookups.
GOOGLE_WEB_RISK_API_KEY=

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
CORS_ALLOWED_ORIGINS=https://trustlens.example.com

# Gemini must use a separate key; never reuse Fact Check credentials.
GEMINI_API_KEY=

